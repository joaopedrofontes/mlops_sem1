# Modelos do Ollama (troque aqui se quiser outro modelo)
LLM_MODEL=qwen2.5:1.5b
EMBED_MODEL=nomic-embed-text

# Parâmetros do RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4

# Silencia aviso do MLflow sobre git (não há git dentro do container)
GIT_PYTHON_REFRESH=quiet

# Avaliação sequencial: em CPU o Ollama não lida bem com requisições paralelas
MLFLOW_GENAI_EVAL_MAX_WORKERS=1
MLFLOW_GENAI_EVAL_MAX_SCORER_WORKERS=1
